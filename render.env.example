# Placeholder-only template for a Render Web Service.
# Replace each placeholder in Render's Environment settings. Do not commit real values.
APP_ENV=production
API_KEY=replace-with-a-unique-random-secret-at-least-32-characters

# Use the provider's TLS-enabled PostgreSQL connection string.
POSTGRES_URL=postgresql://<username>:<password>@<postgres-host>:5432/<database>?sslmode=require

# Qdrant Cloud HTTPS endpoint and API key.
QDRANT_HOST=https://<cluster-id>.<region>.<provider-domain>
QDRANT_API_KEY=replace-with-qdrant-cloud-api-key
QDRANT_COLLECTION=knowledge_base

# Hosted OpenAI-compatible chat provider. Local Ollama is not reachable from Render.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://<chat-provider-host>/v1
LLM_API_KEY=replace-with-chat-provider-api-key
LLM_MODEL=replace-with-chat-model

# Hosted OpenAI-compatible embedding provider. Must match the collection vector size.
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=https://<embedding-provider-host>/v1
EMBEDDING_API_KEY=replace-with-embedding-provider-api-key
EMBED_MODEL=replace-with-embedding-model

# Optional settings. Render supplies PORT; do not hard-code a different value.
# HOST=0.0.0.0
# RATE_LIMIT_PER_MIN=60
# CORS_ORIGINS=https://<frontend-domain>
