# Backend authentication. Generate a unique value for each environment.
API_KEY=replace-with-a-long-random-value

# Set to production for hosted deployment; production enforces TLS and hosted providers.
APP_ENV=development

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
RATE_LIMIT_PER_MIN=60
CORS_ORIGINS=http://localhost:3000

# Fresh local-only password for the Compose PostgreSQL service; keep it private.
POSTGRES_PASSWORD=replace-with-a-unique-local-password

# PostgreSQL; use the matching password above locally and an SSL-enabled URL in production.
POSTGRES_URL=postgresql://triage:replace-with-a-unique-local-password@localhost:15432/tickets

# Chat provider: local development uses Ollama.
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
CLASSIFY_MODEL=tinyllama

# For a hosted OpenAI-compatible chat endpoint, set:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://provider.example/v1
# LLM_API_KEY=replace-with-provider-key
# LLM_MODEL=replace-with-chat-model

# Embedding provider: local development uses Ollama.
EMBEDDING_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text

# For a hosted OpenAI-compatible embeddings endpoint, set:
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_BASE_URL=https://provider.example/v1
# EMBEDDING_API_KEY=replace-with-provider-key
# EMBED_MODEL=replace-with-embedding-model

# Qdrant; QDRANT_API_KEY is optional for a local, unauthenticated instance.
QDRANT_HOST=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_base

# Ingestion settings
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# n8n uses a server-side credential for X-API-Key; this is only its API base URL.
TRIAGE_API_BASE_URL=http://host.docker.internal:8000
